---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const studies = await getCollection('caseStudies', ({ data }) => import.meta.env.DEV || !data.draft);
  return studies.map((study) => ({
    params: { slug: study.id },
    props: { study },
  }));
}

const { study } = Astro.props;
const d = study.data;
const { Content } = await render(study);
---

<Layout title={`${d.client} case study | Darren Harris`} description={d.summary}>
  <article class="case-study">
    {d.draft && <p class="cs-draft">Draft: only visible on your computer.</p>}
    <p class="cs-eyebrow">Case study</p>
    <h1>{d.title}</h1>

    <section class="cs-glance" aria-labelledby="glance-heading">
      <h2 id="glance-heading">At a glance</h2>
      <dl>
        <div><dt>Client</dt><dd>{d.client}</dd></div>
        <div><dt>Sector</dt><dd>{d.sector}</dd></div>
        {d.event && <div><dt>Event</dt><dd>{d.event}</dd></div>}
        {d.audienceSize && <div><dt>Audience</dt><dd>{d.audienceSize}</dd></div>}
        <div><dt>Format</dt><dd>{d.format}</dd></div>
        {d.talk && <div><dt>Talk</dt><dd>{d.talk}</dd></div>}
        {d.year && <div><dt>Year</dt><dd>{d.year}</dd></div>}
      </dl>
    </section>

    {d.quote && (
      <figure class="cs-quote">
        <blockquote><p>“{d.quote.text}”</p></blockquote>
        <figcaption>{d.quote.name}{d.quote.role && `, ${d.quote.role}`}</figcaption>
      </figure>
    )}

    <div class="cs-body">
      <Content />
    </div>

    <section class="cs-cta" aria-labelledby="cta-heading">
      <h2 id="cta-heading">Facing a similar challenge?</h2>
      <p>Let's talk about how the Elite Performance Mindset could help your people perform when it matters most.</p>
      <p><a class="button" href="/birmingham-motivational-speaker/">Book a call</a></p>
    </section>

    <p><a href="/case-studies/">See all case studies</a></p>
  </article>
</Layout>

<style>
  .case-study { max-width: 800px; margin: 0 auto; }
  .cs-draft { background: #f9eeda; border-radius: 6px; padding: 0.5rem 1rem; font-weight: 600; }
  .cs-eyebrow { text-transform: uppercase; letter-spacing: 0.08em; font-weight: 700; color: var(--color-accent); margin-bottom: 0.25rem; }
  .cs-glance { background: #f9fafb; border-left: 4px solid var(--color-accent); border-radius: 6px; padding: 1rem 1.25rem; margin: 1.5rem 0; }
  .cs-glance h2 { margin-top: 0; font-size: 1.15rem; }
  .cs-glance dl { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 0.75rem 1.5rem; margin: 0; }
  .cs-glance dt { font-weight: 700; }
  .cs-glance dd { margin: 0; }
  .cs-quote { margin: 2rem 0; padding: 1.25rem 1.5rem; border-left: 4px solid var(--color-accent); }
  .cs-quote blockquote { margin: 0; font-size: 1.3rem; font-weight: 600; line-height: 1.4; }
  .cs-quote blockquote p { margin: 0; }
  .cs-quote figcaption { margin-top: 0.5rem; color: #4b5563; }
  .cs-cta { background: var(--color-accent); color: #fff; border-radius: 8px; padding: 1.5rem; margin: 2.5rem 0 1.5rem; }
  .cs-cta h2 { margin-top: 0; color: #fff; }
  .cs-cta .button { background: #fff; color: var(--color-accent); border-color: #fff; }
</style>
